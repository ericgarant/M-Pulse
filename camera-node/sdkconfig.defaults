# Rust needs more main-task stack than the 3K default for C.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# This board only streams; the hub owns Bluetooth.
CONFIG_BT_ENABLED=n

# Frame buffers live in PSRAM (the WROVER module has 8 MB, 4 MB mapped).
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_40M=y

# Dashboard and stream: room for the browser's request headers.
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024

# Sockets: two HTTP servers (page on 80, stream on 81), each with a listen and
# a control socket and a few connections, plus the announce and command sockets.
CONFIG_LWIP_MAX_SOCKETS=16

# TCP send buffer per connection (default about 5.7 KB). A larger buffer keeps
# more of each frame in flight, which raises the stream's throughput.
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=32768

# Larger Block Ack window (default 6): more of each frame goes out per burst.
CONFIG_ESP_WIFI_TX_BA_WIN=12

# TCP timer 100 ms (default 250). The hub passes the video on to the viewer
# and drops packets in bursts; each loss the camera notices by timeout froze
# the video 1.3 to 2 s. A finer timer resends sooner.
CONFIG_LWIP_TCP_TMR_INTERVAL=100
