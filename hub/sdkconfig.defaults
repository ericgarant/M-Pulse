# Rust needs more main-task stack than the 3K default for C.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# Bluetooth: NimBLE host, BLE only.
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_NVS_PERSIST=y
# Heater, fridge and Bluetti held at once, plus one spare.
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=4

# Wi-Fi and BLE share the radio.
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

# Dashboard: room for the browser's request headers.
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=128

# Sockets: 10 for the dashboard's web server, 3 it keeps for itself, plus
# the sensor receiver, SNTP and DHCP.
CONFIG_LWIP_MAX_SOCKETS=16
