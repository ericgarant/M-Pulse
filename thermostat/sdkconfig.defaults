# Rust needs more main-task stack than the 3K default for C.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=12288

# Bluetooth: NimBLE host, BLE only (no Bluedroid, no Bluetooth Classic).
CONFIG_BT_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=n
CONFIG_BTDM_CTRL_MODE_BTDM=n

# Diagnostics for the heater link: compile in debug logging so the NimBLE
# host and the BLE client can be turned up at runtime (see `main.rs`).
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y
CONFIG_BT_NIMBLE_LOG_LEVEL_DEBUG=y

# Test for the heater link drop: stop the ESP32 controller from remapping
# the link's radio channels on its own (channel assessment) and from
# running the LE Ping procedure. The heater goes silent about 11 s into
# every link, which fits a link-layer procedure it mishandles.
CONFIG_BTDM_BLE_CHAN_ASS_EN=n
CONFIG_BTDM_BLE_PING_EN=n
